{
  "tool": "oxblend",
  "events": {
    "run": {
      "kind": "span",
      "fields": {
        "command": "command ID (unitless)",
        "argv": "argument strings; never credentials",
        "host": "hostname",
        "version": "tool version",
        "task": "optional task ID (unitless)",
        "variant": "optional configuration ID (unitless)",
        "pid": "process ID (unitless)",
        "env": "optional known environment/build facts (SPEC vocabulary)",
        "episode": "optional stable episode/attempt identity (unitless)",
        "attempt": "optional intentional repeat ordinal (unitless)",
        "seed": "optional integer/string RNG seed; null if unknown",
        "task_hash": "optional algorithm-prefixed task-definition digest",
        "config_hash": "optional algorithm-prefixed configuration digest"
      }
    },
    "file.open": {
      "kind": "span",
      "fields": {
        "path": "lossy UTF-8 filesystem path",
        "size_bytes": "physical size (bytes), when known",
        "decoded_bytes": "decoded capture length in bytes when known",
        "blend": "decode blend capture rather than opaque physical asset (boolean)"
      }
    },
    "index": {
      "kind": "span",
      "fields": {
        "blocks": "indexed block count (count)",
        "types": "SDNA type count (count)",
        "decoded_bytes": "decoded extent in bytes"
      }
    },
    "write": {
      "kind": "span",
      "fields": {
        "path": "output/staging path",
        "bytes": "completed stage bytes; unknown on abandoned write"
      }
    },
    "publish": {
      "kind": "span",
      "fields": {
        "path": "destination path",
        "output_written": "publication observed (boolean)",
        "archive_written": "ZIP publication observed (boolean, when applicable)",
        "durability_completed": "requested sync completed (boolean)"
      }
    },
    "summary": {
      "kind": "span",
      "fields": {
        "note": "CLI command span covers parsing, operation and complete stdout delivery; branch facts belong to child spans"
