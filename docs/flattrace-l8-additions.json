{
  "schema": "oxblend.flattrace-lane-additions/v1",
  "lane": "L8",
  "depends_on": "L5 32c4313e86d6aef0440240e9cc93909a6fca0e2b, direct descendant of integration/next f82aa4f; no cherry-picked L5 copies",
  "root_owner": "L5 owns outputs, resource measurements and diagnostics_complete; L8 adds report member/control facts under report, never overwrites those root keys",
  "scenarios": [
    {
      "command": "help",
      "scenario": "error-known",
      "ordered_parent_path": [
        "run",
        "help",
        "error.help"
      ],
      "required_attributes": {
        "error.help": [
          "catalog_version"
        ]
      },
      "required_events": [
        "diagnostic.invocation",
        "root.summary"
      ],
      "errors": []
    },
    {
      "command": "help",
      "scenario": "error-unknown",
      "ordered_parent_path": [
        "run",
        "help",
        "error.help"
      ],
      "required_attributes": {
        "error.help": [
          "catalog_version"
        ]
      },
      "required_events": [
