# Private local input copies; source hashes/provenance only in version control.
.local-inputs/
.local-results/
.venv/
**/target/
**/__pycache__/
*.pyc
*.blend
*.blend1
*.blend2
# Committed test fixtures are explicit; the blanket rule above must not
# silently drop them (L18: concrete-tile blends were ignored at first add).
!tests/fixtures/**/*.blend
