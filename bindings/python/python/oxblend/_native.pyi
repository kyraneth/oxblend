"""Reviewed native adapter boundary. Public annotated facade is ``__init__.py``.

This module is private (``oxblend._native``). Reports are owned JSON-compatible
values (``dict``/``list``/scalars), never JSON text; no field is renamed. The
module declares ``gil_used = false`` and releases the GIL around long engine
work; Python object conversion still follows the host interpreter's GIL rules.

Writer adapters are registered by ``src/writers.rs`` and specified by the lane's
``writers-API.md``. Read adapters are registered by ``src/reads.rs``; their
declarations follow that module's own API record and are updated with it rather
than guessed here.
"""
import pathlib
from typing import Any, Never, Mapping, final
from .diagnostics import SourceDiagnostic as _SourceDiagnosticRecord

__version__: str
engine_version: str
__build_commit__: str

class OxblendError(Exception):
    """Native error carrier. The public facade normalizes it per error kind."""

    kind: str
    message: str
    operation: str
    context: tuple[tuple[str, int], ...]
    diagnostics: Any
    diagnostic_ref: Any
    source_snapshot: _SourceDiagnosticRecord | None
    _source_snapshot: SourceDiagnostic | None
    report: Any
    effects: str
    # Filled by the public facade from docs/error-catalog.json, so every raised
    # error carries the same remedy text as the CLI. Raw native raises before
    # normalization may leave them unset.
    exit_code: int
    explanation: str | None
    likely_causes: tuple[str, ...]
    next_steps: tuple[str, ...]
    known_issue: str | None
    next_command: Mapping[str, Any] | None
class ClosedFileError(OxblendError): ...
class SourceChangedError(OxblendError): ...

@final
class SourceDiagnostic:
    """Private opaque native snapshot; public records live in diagnostics.py."""
    def __init__(self, _internal_only: Never) -> None: ...
    @property
    def kind(self) -> str: ...
    @property
    def check_id(self) -> str: ...
    def to_json(self) -> dict[str, Any]: ...

@final
class BlockInfo:
    def __init__(self, _internal_only: Never) -> None: ...
    @property
    def index(self) -> int: ...
    @property
    def code(self) -> bytes: ...
    @property
    def old_address(self) -> int: ...
    @property
    def sdna_index(self) -> int: ...
    @property
    def count(self) -> int: ...
    @property
    def data_offset(self) -> int: ...
    @property
    def size(self) -> int: ...

_Query = tuple[BlockInfo, int, tuple[bytes | int, ...], bool]
_Header = tuple[int, int, bool, int, int]
# Recursive value transport. A top-level query result is the triple
# (engine kind, exact integer/bytes/tuple payload, exact schema-1 JSON
# projection); a nested array element is the pair (kind, payload) and takes its
# projection from the parent's ``projection["items"]``. The projection is what
# ``FieldValue.to_json`` wraps as ``{"schema": 1, "value": ...}``.
_Value = tuple[str, Any, Any]
_NestedValue = tuple[str, Any]

@final
class File:
    def __init__(self, _internal_only: Never) -> None: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def memory(self) -> str: ...
    def validate_sources(self) -> None: ...
    def header(self) -> _Header: ...
    def blocks(self, code: bytes | None = None) -> tuple[BlockInfo, ...]: ...
    def get(self, items: tuple[_Query, ...]) -> tuple[_Value, ...]: ...
    def pointer(self, items: tuple[_Query, ...]) -> BlockInfo | None: ...
    def byte_array(self, items: tuple[_Query, ...], count: int) -> bytes: ...
    def pointer_table(
        self, items: tuple[_Query, ...], count: int
    ) -> list[BlockInfo | None]: ...
    def validate_block(self, block: BlockInfo) -> None: ...
    @property
    def open_diagnostics(self) -> tuple[dict[str, Any], ...]: ...
    # Typed summary fields plus exactly one of the private `_json` projection
    # or `_json_error`, produced by one summarize_typed read (never duplicated).
    def summary(self) -> dict[str, Any]: ...
    @property
    def root_paths(self) -> tuple[pathlib.Path, ...]: ...
    @property
    def source_spelling(self) -> pathlib.Path | None: ...
    def query(self, type_name: str, fields: tuple[str, ...]) -> dict[str, Any]: ...
    def explain(self, concept: str) -> dict[str, Any]: ...
    def inspect(self) -> dict[str, Any]: ...
    def payload(self, block: int) -> dict[str, Any]: ...
    def get_json(
        self,
        block: int,
        path: str,
        element: int = 0,
        raw: bool = False,
        byte_array: int | None = None,
        pointer_table: int | None = None,
    ) -> dict[str, Any]: ...
    def pointer_json(
        self, block: int, path: str, element: int = 0
    ) -> dict[str, Any]: ...
    def pointer_census(self, full: bool = False) -> dict[str, Any]: ...
    def source_facts(self) -> dict[str, Any]: ...
    def library_facts(self) -> dict[str, Any]: ...
    def trace(
        self, recursive: bool = True, low_memory: bool = False
    ) -> dict[str, Any]: ...
    def list_dependencies(self, full_info: bool = False, low_memory: bool = False) -> dict[str, Any]: ...
    def pack_sequence(self, destination: str, project_root: str | None, exclude: tuple[str, ...] = (), dry_run: bool = False, relative_only: bool = False, compress: bool = False, keep_hierarchy: bool = True, permissive: bool = False, durability: str = 'none', memory: str | None = None) -> dict[str, Any]: ...
    def pack(
        self,
        destination: str,
        project_root: str | None,
        *,
        dry_run: bool = False,
        permissive: bool = False,
        compress: bool = False,
        keep_hierarchy: bool = False,
        memory: str | None = None,
        exclude: tuple[str, ...] = (),
        relative_only: bool = False,
        durability: str = "none",
    ) -> dict[str, Any]: ...

def open(path: str, *, memory: str | None = ...) -> File: ...
def open_many(paths: tuple[str, ...], *, memory: str | None = ...) -> File: ...
def trace_many(paths: tuple[str, ...], recursive: bool = True, low_memory: bool = False) -> dict[str, Any]: ...
def list_many(paths: tuple[str, ...], full_info: bool = False, low_memory: bool = False) -> dict[str, Any]: ...
def pack_sequence(paths: tuple[str, ...], destination: str, project_root: str | None = None, exclude: tuple[str, ...] = (), dry_run: bool = False, relative_only: bool = False, compress: bool = False, keep_hierarchy: bool = True, permissive: bool = False, durability: str = 'none', memory: str = 'fast') -> dict[str, Any]: ...
def pack(path: str, destination: str, project_root: str | None = None, exclude: tuple[str, ...] = (), dry_run: bool = False, relative_only: bool = False, compress: bool = False, keep_hierarchy: bool = False, permissive: bool = False, durability: str = 'none', memory: str = 'fast') -> dict[str, Any]: ...
def trace_path(
    path: str, recursive: bool = True, low_memory: bool = False
) -> dict[str, Any]: ...
def catalog() -> dict[str, Any]: ...
def error_catalog() -> dict[str, Any]: ...
def next_command(kind: str, command: str, source: str | None = None) -> dict[str, Any] | None: ...
def explain(concept: str) -> dict[str, Any]: ...
def initialize_identity(path: str, sha256: str) -> None: ...
def report_direct_preview(output: str, error: OxblendError | None = None, result: Any = None, *, include_names: bool = False, include_file: str | None = None) -> dict[str, Any]: ...

# --- read adapters (src/reads.rs; see the lane's reads-API.md) ---
# Each opens one transient fast-retention capture, releases the GIL for the
# engine work and returns the engine's owned JSON projection.
def inspect(path: str) -> dict[str, Any]: ...
def payload(path: str, block: int) -> dict[str, Any]: ...
def source_facts(path: str) -> dict[str, Any]: ...
def library_facts(path: str) -> dict[str, Any]: ...
def pointer_census(path: str, full: bool = False) -> dict[str, Any]: ...
def exr_header(path: str) -> dict[str, Any]: ...
def exr_scan(
    inputs: tuple[str, ...], jobs: int | None = None
) -> tuple[dict[str, Any], ...]: ...
def exr_pixels(
    input: str, output: str, part: int, pass_name: str
) -> dict[str, Any]: ...
def block_report(
    path: str,
    limit: int = 10,
    address: int | None = None,
    dump: bool = False,
) -> dict[str, Any]: ...
def list_dependencies(
    path: str, full_info: bool = False, low_memory: bool = False
) -> dict[str, Any]: ...

# --- writer adapters (src/writers.rs; see the lane's writers-API.md) ---
def diff(a: str, b: str) -> dict[str, Any]: ...
def edit(
    input: str,
    output: str,
    spec: str,
    mode: str,
    durability: str = "none",
) -> dict[str, Any]: ...
def node_tree(path: str) -> dict[str, Any]: ...
def extract(
    input: str,
    output: str,
    ids: tuple[str, ...] = (),
    blocks: tuple[int, ...] = (),
    clear: tuple[str, ...] = (),
    durability: str = "none",
