    stdout: str | None = None,
    trace: str | None = None,
    trace_dir: str | None = None,
    run_id: str | None = None,
    last: bool = False,
    include_names: bool = False,
    include_file: str | None = None,
) -> dict[str, Any]: ...
def report_create(
    preview: str, preview_sha256: str, output: str
) -> dict[str, Any]: ...
def report_discard(preview: str, preview_sha256: str) -> dict[str, Any]: ...
