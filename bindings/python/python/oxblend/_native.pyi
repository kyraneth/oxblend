def pack_input_error() -> dict[str, Any]: ...
# One coherent strict/refusal seam for every `_admit` operation (see
# src/strict.rs). Returns the canonical (kind, message) the CLI delivery
# check emits; unknown operations fail loudly as usage, never synthesized.
def strict_refusal(operation: str, report_json: str, command: str | None = None, input_display: str | None = None) -> tuple[str, str]: ...
def overrides(path: str, recursive: bool = True) -> dict[str, Any]: ...
def read_path_list(path: str, nul: bool = False) -> tuple[pathlib.Path, ...]: ...
def report_preview(
    output: str,
