#!/usr/bin/env bash
# Generate THIRD-PARTY-NOTICES from the licence texts vendored beside the
# locked crate sources. Deterministic and offline: reads Cargo.lock, the
# vendored manifests under $CARGO_HOME/registry/src and this target's built
# dependency graph. Scripts/licence-gate.sh regenerates and compares.
#
# Scope:
#   * every package in this target's built graph (`cargo tree -e normal,build`).
# Every other locked package is named without text, independent of cache state.
# A built package without vendored text is a hard failure: the distributed
# artifact would carry a licence that cannot be reproduced.
set -euo pipefail
cd "$(dirname "$0")/.."

cargo_home=${CARGO_HOME:-$HOME/.cargo}
sources=()
while IFS= read -r dir; do
    if [ -n "$dir" ]; then
        sources+=("$dir")
    fi
done < <(ls -d "$cargo_home"/registry/src/*/ 2>/dev/null | LC_ALL=C sort)
if [ ${#sources[@]} -eq 0 ]; then
    printf 'third-party-notices: no vendored crate sources under %s/registry/src\n' "$cargo_home" >&2
    exit 1
fi

lock_packages() {
    awk '
        /^\[\[package\]\]/ { name = ""; version = "" }
        /^name = / { name = $0; sub(/^name = "/, "", name); sub(/"$/, "", name) }
        /^version = / { version = $0; sub(/^version = "/, "", version); sub(/"$/, "", version) }
        /^source = "registry/ { print name "\t" version }
    ' Cargo.lock | LC_ALL=C sort -u
}

built_packages() {
    cargo tree --offline --locked -e normal,build --prefix none --format '{p}' |
        sed 's/ (.*$//; s/ v/\t/' | LC_ALL=C sort -u
}

package_license() {
    awk -F' = ' '
        /^\[/ { section = $0 }
        section == "[package]" && $1 == "license" {
            value = $2
            sub(/^"/, "", value)
            sub(/"$/, "", value)
            print value
            exit
        }
    ' "$1/Cargo.toml"
}

find_source() {
    local name=$1 version=$2 dir
    for dir in "${sources[@]}"; do
        if [ -d "$dir$name-$version" ]; then
            printf '%s\n' "$dir$name-$version"
            return 0
        fi
    done
    return 1
}

licence_files() {
    find "$1" -maxdepth 1 \
        \( -iname 'licen[cs]e*' -o -iname 'copying*' -o -iname 'unlicense*' -o -iname 'notice*' \) \
        -print | LC_ALL=C sort
}

emit_section() {
    local name=$1 version=$2 dir=$3 license=$4 file
    local -a files=()
    while IFS= read -r file; do
        files+=("$file")
    done < <(licence_files "$dir")
    printf '=%.0s' {1..78}
    printf '\n%s %s\n' "$name" "$version"
    printf 'Declared licence: %s\n' "$license"
    printf 'Vendored licence files:'
    if [ ${#files[@]} -eq 0 ]; then
        printf ' none\n'
    else
        for file in "${files[@]}"; do
            printf ' %s' "$(basename "$file")"
        done
        printf '\n'
    fi
    printf -- '-%.0s' {1..78}
    printf '\n'
    for file in "${files[@]}"; do
        if [ -d "$file" ]; then
            while IFS= read -r inner; do
                cat "$inner"
                printf '\n'
            done < <(find "$file" -type f -print | LC_ALL=C sort)
        else
            cat "$file"
            printf '\n'
        fi
    done
}

built=$(built_packages)
locked=$(lock_packages)
declare -A is_built=()
while IFS=$'\t' read -r bname bversion; do
    if [ -n "$bname" ]; then
        is_built["$bname $bversion"]=1
    fi
done <<< "$built"

printf '%s\n' \
    'THIRD-PARTY NOTICES' \
    '' \
    'Oxblend 1.4.1' \
    '' \
    'Generated by scripts/third-party-notices from Cargo.lock and the licence' \
    'texts vendored beside the locked crate sources. Do not edit by hand: run' \
    'scripts/licence-gate.sh to regenerate and compare.' \
    '' \
    'Scope' \
    '-----' \
    'Every package in the built dependency graph for this target is reproduced' \
    'in full below (`cargo tree -e normal,build`). Every other locked package' \
    'is named without a text, regardless of its presence in the local cache.' \
    'The gate proves those packages are outside the' \
    'built graph. The whole graph is permissive; no copyleft licence is selected.' \
    '' \
    'Licence choices' \
    '---------------' \
    '' \
    '* zstd, zstd-safe and zstd-sys are BSD-3-Clause. zstd-sys vendors the' \
    '  upstream Zstandard tree, which also carries zstd/COPYING, the GPLv2 text' \
    '  for the upstream command-line programs. Oxblend selects the BSD-3-Clause' \
    '  licence declared by those crates (reproduced below) and neither builds' \
    '  nor distributes those programs: zstd-sys builds only the static libzstd' \
    '  (ZSTD_BUILD_PROGRAMS=OFF, ZSTD_BUILD_STATIC=ON, ZSTD_BUILD_SHARED=OFF).' \
    '* Where a crate declares a choice, every licence text it vendors at its' \
    '  root is reproduced, and the crate declares which expression applies.'

printf '\nVendored Rust writer: flattrace v1 (MIT), https://github.com/kyraneth/flattrace\n'
cat src/flattrace-LICENSE

while IFS=$'\t' read -r name version; do
    if [ -z "$name" ]; then
        continue
    fi
    if [ -n "${is_built["$name $version"]+set}" ]; then
        if ! dir=$(find_source "$name" "$version"); then
            printf 'third-party-notices: %s %s is built but has no vendored licence text\n' \
                "$name" "$version" >&2
            exit 1
        fi
        emit_section "$name" "$version" "$dir" "$(package_license "$dir")"
    else
        printf '=%.0s' {1..78}
        printf '\n%s %s\n' "$name" "$version"
        printf 'Declared licence: not read (outside this target built graph)\n'
        printf 'This package is locked for other targets, is not in this target\n'
        printf 'built graph, and is not compiled or distributed.\n'
        printf -- '-%.0s' {1..78}
        printf '\n'
    fi
done <<< "$locked"
